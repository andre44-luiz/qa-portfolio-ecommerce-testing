{
  "info": {
    "_postman_id": "7a2d9c90-8b28-4c12-90a6-1f4b0f2026aa",
    "name": "QA Portfolio - DummyJSON",
    "description": "Collection educacional para o portfólio de André Luiz. Os requests não representam integração com o SauceDemo. Resultados devem ser registrados somente após execução real.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://dummyjson.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Produtos",
      "item": [
        {
          "name": "API-EP-001 - Listar produtos limit=1 skip=0",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?limit=1&skip=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                },
                {
                  "key": "skip",
                  "value": "0"
                }
              ]
            },
            "description": "Caso relacionado: TC-API-001."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Tempo abaixo de 5000 ms (limite educacional)', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
                  "const body = pm.response.json();",
                  "pm.test('Estrutura de paginação', function () {",
                  "  pm.expect(body.products).to.be.an('array');",
                  "  pm.expect(body.total).to.be.a('number');",
                  "  pm.expect(body.skip).to.eql(0);",
                  "  pm.expect(body.limit).to.eql(1);",
                  "  pm.expect(body.products.length).to.be.at.most(1);",
                  "});",
                  "if (body.products.length > 0) {",
                  "  pm.test('Tipos do primeiro produto', function () {",
                  "    pm.expect(body.products[0].id).to.be.a('number');",
                  "    pm.expect(body.products[0].title).to.be.a('string');",
                  "    pm.expect(body.products[0].price).to.be.a('number');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "API-EP-002 - Obter produto por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "{{product_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Campos e tipos principais', function () {",
                  "  pm.expect(body.id).to.eql(Number(pm.environment.get('product_id')));",
                  "  pm.expect(body.title).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.price).to.be.a('number');",
                  "  pm.expect(body.category).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-EP-002 NEG - Produto com ID em formato inválido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/abc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "abc"
              ]
            },
            "description": "Caso relacionado: TC-API-002. O código exato deve ser registrado na execução."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resposta indica erro de cliente', function () {",
                  "  pm.expect(pm.response.code).to.be.within(400, 499);",
                  "});",
                  "pm.test('Não retorna produto válido como sucesso', function () {",
                  "  let body = {};",
                  "  try { body = pm.response.json(); } catch (e) {}",
                  "  pm.expect(!(pm.response.code === 200 && typeof body.id === 'number' && typeof body.title === 'string')).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-EP-003 - Pesquisar produtos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/search?q={{search_term}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{search_term}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Estrutura da pesquisa', function () {",
                  "  pm.expect(body.products).to.be.an('array');",
                  "  pm.expect(body.total).to.be.a('number');",
                  "  pm.expect(body.skip).to.be.a('number');",
                  "  pm.expect(body.limit).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "API-EP-004 - Login válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"expiresInMins\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Usuário e tokens presentes', function () {",
                  "  pm.expect(body.username).to.eql(pm.environment.get('username'));",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "if (body.accessToken) { pm.environment.set('access_token', body.accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "API-EP-004 NEG - Login inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario_inexistente\",\n  \"password\": \"senha_invalida\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status de erro de autenticação', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
                  "});",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('Não retorna accessToken', function () {",
                  "  pm.expect(body).to.not.have.property('accessToken');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
